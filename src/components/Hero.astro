---
import { PortableText } from "astro-portabletext";
import { proseComponents } from "./prose/components";
import {
  getHeroImages,
  heroLandscapeDimensions,
  HERO_MOBILE_MAX,
  HERO_TABLET_MAX,
} from "../lib/heroImages";
import HeroLead from "./hero/HeroLead.astro";
import { getHomeHero } from "../sanity/lib/homePage";
import { getWistiaMeta } from "../lib/wistia";

const hero = await getHomeHero();

// Fail the build loudly rather than rendering an empty hero — a silent blank
// homepage is far worse to debug than a message that says what to do.
if (!hero) {
  throw new Error(
    "No Home Page hero content found in Sanity.\n" +
      "Add it in the Studio at /admin → Home Page → Hero.",
  );
}

// The poster comes from Wistia, not Sanity — it's the media's own thumbnail.
const wistiaId = hero.caption?.video?.wistiaId;
const heroVideoPoster = wistiaId ? (await getWistiaMeta(wistiaId)).poster : undefined;

// The three art-directed crops live in ../lib/heroImages so HeroPreload.astro
// can emit a matching <link rel="preload"> in the head. Keep the breakpoints
// below in step with the media queries there.
const { heroDesktop, heroTablet, heroMobile } = await getHeroImages();
---

<section class="hero">
  <picture class="hero__picture">
    {/* Narrowest first — <picture> takes the first matching source, so the
        900px rule would otherwise swallow phones too. */}
    <source
      media={`(max-width: ${HERO_MOBILE_MAX}px)`}
      srcset={heroMobile.srcSet.attribute}
      sizes="100vw"
      type="image/webp"
    />
    <source
      media={`(max-width: ${HERO_TABLET_MAX}px)`}
      srcset={heroTablet.srcSet.attribute}
      sizes="100vw"
      type="image/webp"
    />
    <source srcset={heroDesktop.srcSet.attribute} sizes="100vw" type="image/webp" />
    <img
      class="hero__img"
      src={heroDesktop.src}
      width={heroLandscapeDimensions.width}
      height={heroLandscapeDimensions.height}
      alt="Dan Cogdell seated in the firm's boardroom"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero__scrim"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow"><span class="hero__rule"></span>{hero.eyebrow}</p>

      <h1 class="hero__title">
        <span class="hero__title-line hero__title-line--accent">{hero.titleAccent}</span>
        <span class="hero__title-line">{hero.titleSecond}</span>
      </h1>

      <PortableText value={hero.lead} components={{
          ...proseComponents,
          block: { ...proseComponents.block, normal: HeroLead },
        }} />

      <div class="hero__actions">
        {
          hero.ctas?.map((cta, i) => (
            <a
              href={cta.href}
              class:list={["btn", i === 0 ? "btn--primary" : "btn--outline"]}
            >
              {cta.label}
              <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          ))
        }
      </div>
    </div>

    <figure class="hero__caption">
      <figcaption class="hero__attribution">
        <span class="hero__name">{hero.caption?.name}</span>
        <span class="hero__role">{hero.caption?.role}</span>
      </figcaption>

      <a href="/videos" class="hero__watch" data-video-id={wistiaId} data-video-poster={heroVideoPoster}>
        <span class="hero__play">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
        <span class="hero__watch-label">
          <span class="hero__watch-sm">Watch</span>
          <span class="hero__watch-film">{hero.caption?.watchLabel}</span>
        </span>
      </a>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(600px, 82vh, 840px);
    background-color: var(--cog-navy-deep);
    overflow: hidden;
    color: var(--cog-white);
  }

  .hero__picture {
    display: contents;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  /* Darken the left so the text stays legible over the image. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--cog-navy-deep) 0%,
        rgba(7, 16, 29, 0.85) 32%,
        rgba(7, 16, 29, 0.25) 62%,
        transparent 100%
      ),
      linear-gradient(to top, rgba(7, 16, 29, 0.6) 0%, transparent 35%);
  }

  .hero__inner {
    position: relative;
    min-height: inherit;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-8);
    padding-block: var(--space-16);
  }

  /* ---- Content ---- */
  .hero__content {
    align-self: center;
    max-width: 40rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cog-accent);
  }
  .hero__rule {
    width: 2.5rem;
    height: 2px;
    background-color: var(--cog-accent);
  }

  .hero__title {
    margin-top: var(--space-4); /* standard eyebrow → heading gap */
    margin-bottom: var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.04;
    font-size: clamp(2.75rem, 5vw, 4.75rem); /* 44 → 76px */
  }
  .hero__title-line {
    display: block;
    font-weight: bold;
  }
  .hero__title-line--accent {
    font-style: italic;
    color: var(--cog-cream);
  }

  /* Emitted by HeroLead.astro (a Portable Text renderer), so it carries no
     scoping attribute of its own — see F14. The scoped .hero__content parent
     bounds the :global. */
  .hero__content :global(.hero__lead) {
    max-width: 34rem;
    font-size: var(--text-lg);
    color: var(--cog-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* ---- Caption bar (over the portrait) ---- */
  .hero__caption {
    grid-row: 2;
    justify-self: end;
    align-self: end;
    display: flex;
    align-items: stretch;
    max-width: 100%;
    margin: 0;
    background-color: rgba(14, 27, 45, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
  }
  .hero__attribution {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
  }
  .hero__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
  }
  .hero__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cog-accent);
  }

  .hero__watch {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-left: 1px solid var(--cog-line-strong);
    text-decoration: none;
    color: var(--cog-white);
    transition: background-color var(--transition);
  }
  .hero__watch:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }
  .hero__play {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--cog-accent);
    border-radius: 50%;
    color: var(--cog-accent);
    flex-shrink: 0;
    transition: background-color var(--transition), color var(--transition);
  }
  .hero__play svg path {
    fill: var(--cog-white);
  }
  /* Subtle pulse radiating outward to draw the eye to the play button. */
  .hero__play::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--cog-accent);
    opacity: 0;
    pointer-events: none;
    animation: hero-pulse 2.8s var(--ease) infinite;
  }
  @keyframes hero-pulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    70% {
      opacity: 0;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__play::after {
      animation: none;
    }
  }
  .hero__watch:hover .hero__play {
    background-color: var(--cog-accent);
    color: var(--cog-white);
  }
  .hero__watch-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
    white-space: nowrap;
  }
  .hero__watch-sm {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cog-navlink);
  }
  .hero__watch-film {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  /* ---- Responsive ---- */
  /* Tablet: caption spans full width, split into two equal halves. */
  @media (max-width: 1024px) {
    .hero__inner {
      padding-block: var(--space-8);
    }
    /* Portrait image → darken from the bottom up so the lower content reads. */
    .hero__img {
      object-position: center;
    }
    .hero__scrim {
      background: linear-gradient(
        to top,
        var(--cog-navy-deep) 0%,
        rgba(7, 16, 29, 0.75) 32%,
        rgba(7, 16, 29, 0.25) 62%,
        transparent 100%
      );
    }
    .hero__caption {
      justify-self: stretch;
    }
    .hero__attribution,
    .hero__watch {
      flex: 1 1 50%;
      width: 50%;
    }
  }
  @media (max-width: 900px) {
    .hero__content {
      align-self: flex-end;
    }
  }
  @media (max-width: 650px) {
    /* Phones: stack rather than overlay. Behind the copy, `cover` on a tall
       narrow screen put Dan mid-frame while the bottom-aligned text ran across
       his face — no scrim tuning fixes that, because the text itself is opaque.
       As a band above the copy the two can't collide at any height, and the
       hero grows with its content instead of cropping to fit.
       Same approach as StatementBand and FirmStory at their breakpoints. */
    .hero {
      min-height: 0;
    }
    /* Becomes a positioned block so the gradient below can anchor to the photo's
       own bottom edge — `display: contents` leaves it with no box to hang off. */
    .hero__picture {
      display: block;
      position: relative;
    }
    /* Fades the foot of the photo into the section's navy so the copy reads as
       emerging from the image rather than butting against a hard seam. Ends on
       --cog-navy-deep, which is .hero's own background, so the join is seamless. */
    .hero__picture::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 45%;
      background: linear-gradient(
        to top,
        var(--cog-navy-deep) 0%,
        rgba(7, 16, 29, 0.72) 38%,
        transparent 100%
      );
      pointer-events: none;
    }
    .hero__img {
      position: static;
      display: block;
      width: 100%;
      height: auto;
      /* Matches the crop exactly, so `cover` never trims it further. */
      aspect-ratio: 738 / 540;
    }
    /* The scrim exists only to hold text legible ON the photo. Nothing sits on
       it now, and left in place it would tint the whole stacked section — the
       ::after above does the blending instead. */
    .hero__scrim {
      display: none;
    }
    .hero__inner {
      min-height: 0;
      /* Tight to the top so the copy starts inside the fade rather than after a
         gap, which is what makes the two read as one panel. */
      padding-block: var(--space-6) var(--space-12);
    }
    .hero__content {
      align-self: start;
      max-width: none;
    }
    /* Keep the headline to its two authored lines.
       Each .hero__title-line is already display:block, so the two-line split is
       structural — the problem was the type size. The base clamp bottoms out at
       44px, and "Other Lawyers Call." runs about 7.9em in Cormorant bold, so it
       needs roughly (viewport - 48px of container padding) / 7.9 — about 43px at
       390px wide. It was overflowing and wrapping to four lines.
       Sizing off vw instead keeps both lines intact from 320px up, with ~8%
       headroom. Deliberately no `white-space: nowrap`: the copy is editable in
       Sanity, and a longer headline should wrap rather than run off-screen. */
    .hero__title {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }
    /* Full width now that it isn't sharing the frame with the photo. */
    .hero__caption {
      justify-self: stretch;
      flex-direction: column;
    }
    .hero__attribution,
    .hero__watch {
      flex: none;
      width: 100%;
    }
    .hero__watch {
      border-left: none;
      border-top: 1px solid var(--cog-line-strong);
    }
  }
</style>
