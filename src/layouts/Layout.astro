---
import Font from "astro/components/Font.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/video/VideoLightbox.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { getFirmDetails } from "../sanity/lib/firmDetails";
import { getGlobalSeo } from "../sanity/lib/seo";
import { urlFor } from "../sanity/lib/image";
import { resolveSeo, SITE_NAME, type SeoInput } from "../lib/seo";
import { legalServiceSchema } from "../lib/schema";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The page's Sanity `seo` block. Every field optional; blank → title/description above. */
  seo?: SeoInput | null;
  /**
   * Set on any page that renders a `data-video-id` trigger (today: the homepage
   * hero and /videos). It does two things — warms up Wistia's DNS in the head,
   * and renders the <VideoLightbox>. WITHOUT IT THE LIGHTBOX IS ABSENT and a
   * video thumbnail click does nothing, so a new page with video must set it.
   */
  videoEmbed?: boolean;
  /**
   * Set on pages that embed a YouTube video (today: the podcast episode pages).
   * Deliberately NOT folded into `videoEmbed` — that one also renders the Wistia
   * <VideoLightbox>, which these pages must not get. This only warms up DNS.
   */
  youtubeEmbed?: boolean;
}

const { title, description, seo, videoEmbed = false, youtubeEmbed = false } = Astro.props;

const firm = await getFirmDetails();
const globalSeo = await getGlobalSeo();

const meta = resolveSeo(seo, {
  fallbackTitle: title,
  fallbackDescription: description,
  pageUrl: Astro.url,
  // Site-wide fallback share image lives on the Global SEO Setting singleton.
  defaultOgImage: globalSeo?.defaultOgImage,
});

// The site-wide "discourage crawling" switch (Global SEO Settings) forces
// noindex on every page, over-riding the per-page flag — used to keep the site
// off Google while it's on its temporary address.
const robotsNoIndex = meta.noIndex || globalSeo?.discourageCrawling === true;

// `Astro.site` is set in astro.config.mjs; the fallback keeps a bare `astro dev`
// (which can run without it) from throwing on a template literal.
const siteUrl = (Astro.site?.href ?? "https://www.cogdell-law.com/").replace(/\/+$/, "");
const logoUrl = firm?.logo ? urlFor(firm.logo).width(600).auto("format").url() : undefined;
const organization = legalServiceSchema(firm, siteUrl, logoUrl);

// PageProofer, the client-review annotation widget. Gated on the env var rather
// than hardcoded so switching it off at launch is a Vercel settings change, not
// a code change: unset PUBLIC_PAGEPROOFER_SITE_ID and the next build ships
// without the tag at all. See "Before launch" in the README.
const pageProoferSiteId = import.meta.env.PUBLIC_PAGEPROOFER_SITE_ID;

// Google Tag Manager. The container id is public — it ships in the page source —
// and permanent, so it is hardcoded rather than an env var. That is the whole
// point of GTM per the README: this is the ONE tag that goes in the repo, and
// every tag after it is a GTM change with no rebuild and no deploy.
//
// PRODUCTION ONLY. Vercel sets VERCEL_ENV on every build; without this gate each
// branch preview would report the team's own browsing into the firm's analytics,
// and `npm run dev` would too.
//
// Snippets are injected with set:html. Astro would otherwise bundle a bare
// <script> — hoisting it and making it a deferred module — and the dataLayer
// bootstrap has to run inline, in the head, before anything can push to it.
// (The container load is deferred deliberately; that is our doing, not
// Astro's. See GTM_HEAD.) The noscript iframe keeps its inline style for a
// related reason: it is vendor markup, and the house no-inline-styles rule is
// about our design, not about editing a third party's snippet until it breaks.
const GTM_ID = "GTM-NCPC4MK6";

// PUBLIC_GTM_PREVIEW is a measurement escape hatch, not a feature flag. GTM is
// the heaviest thing on the page, so a preview deploy without it scores several
// PageSpeed points better than the real site and tells you nothing. Set it on a
// single branch in Vercel while you measure, then take it off. Leave it unset
// everywhere else — turning it on for the whole Preview environment would put
// every branch build's traffic into the firm's analytics.
const gtmEnabled =
  process.env.VERCEL_ENV === "production" ||
  import.meta.env.PUBLIC_GTM_PREVIEW === "true";

// GTM's own snippet, with one change: gtm.js is injected on the first sign of a
// real visitor instead of immediately. The container plus GA4 is ~160 kB, and
// on a throttled phone that queue sat directly in front of the hero image — the
// LCP element — costing seconds. Deferring it takes those bytes off the
// critical path and its execution out of the Total Blocking Time window.
//
// What is preserved: `dataLayer` exists from the first line, so anything that
// pushes before the container loads still queues and replays. The noscript
// iframe is untouched.
//
// What it costs: a pageview reports a few seconds late, and a visitor who
// leaves inside 3 s without touching the page may not be counted at all.
//
// `gtm.start` is stamped at injection rather than at page start — that is what
// every delay-GTM recipe does, and it is what GTM's own timing reads.
const GTM_HEAD = `(function(w,d,s,l,i){w[l]=w[l]||[];
var loaded=false;
function load(){if(loaded)return;loaded=true;
w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
f.parentNode.insertBefore(j,f);}
['pointerdown','keydown','scroll','touchstart'].forEach(function(e){
w.addEventListener(e,load,{once:true,passive:true});});
w.addEventListener('load',function(){setTimeout(load,3000);});
})(window,document,'script','dataLayer','${GTM_ID}');`;

const GTM_BODY = `<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}"
height="0" width="0" style="display:none;visibility:hidden"></iframe>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* dataLayer is set up here, as high as GTM asks; the container itself
        loads later — see GTM_HEAD above. */}
    {gtmEnabled && <script is:inline set:html={GTM_HEAD} />}
    {/* Flag JS up front so the lazy-image fade only hides images when it can un-hide them. */}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* The firm logo in the header is a cdn.sanity.io image, above the fold on
        every page, and so are the attorney portraits further down. Warming the
        connection saves the DNS + TCP + TLS round trip from the critical path.
        No `crossorigin`: these are plain image fetches, and the attribute would
        open a second connection nothing uses. */}
    <link rel="preconnect" href="https://cdn.sanity.io" />
    {/* Page-specific head content — today, the homepage's LCP image preload.
        Placed BEFORE the <Font> tags on purpose: several preloads land in the
        same priority bucket, and document order decides which fetch starts
        first. The hero image should win that race, not a font. */}
    <slot name="head" />
    {
      videoEmbed && (
        <Fragment>
          {/* DNS-only warm-up (cheap; no eager TLS competing with page load).
              The lightbox loads the Wistia player on click. */}
          <link rel="dns-prefetch" href="https://fast.wistia.net" />
          <link rel="dns-prefetch" href="https://embed-ssl.wistia.com" />
          <link rel="dns-prefetch" href="https://fast.wistia.com" />
          <link rel="dns-prefetch" href="https://distillery.wistia.com" />
        </Fragment>
      )
    }
    {
      youtubeEmbed && (
        <Fragment>
          {/* DNS-only, like the Wistia hints above: the player itself loads on
              click, so there is nothing to preconnect to until then. */}
          <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
          <link rel="dns-prefetch" href="https://i.ytimg.com" />
        </Fragment>
      )
    }
    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-instrument" preload />
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <link rel="canonical" href={meta.canonical} />
    {robotsNoIndex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    {meta.description && <meta property="og:description" content={meta.description} />}
    <meta property="og:url" content={meta.canonical} />
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}

    <meta name="twitter:card" content={meta.ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={meta.title} />
    {meta.description && <meta name="twitter:description" content={meta.description} />}
    {meta.ogImage && <meta name="twitter:image" content={meta.ogImage} />}

    {organization && <JsonLd data={organization} />}
  </head>
  <body>
    {/* GTM's no-JS fallback. Its own docs put this immediately after <body>. */}
    {gtmEnabled && <noscript set:html={GTM_BODY} />}
    <Header />
    <slot />
    <Footer />
    {videoEmbed && <VideoLightbox />}
    {
      /* Last in the body on purpose: a review-only widget shouldn't compete with
         fonts, CSS or images for bandwidth during the initial load. */
      pageProoferSiteId && (
        <script is:inline async src={`https://app.pageproofer.com/embed/${pageProoferSiteId}`} />
      )
    }
    <script>
      // Fade each lazy image in once it decodes (covers the already-cached case).
      document
        .querySelectorAll<HTMLImageElement>("img.lazy-fade")
        .forEach((img) => {
          if (img.complete) {
            img.classList.add("is-loaded");
          } else {
            img.addEventListener("load", () => img.classList.add("is-loaded"), {
              once: true,
            });
          }
        });
    </script>
  </body>
</html>
